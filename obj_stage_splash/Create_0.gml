timer = 0;

fade_in_time = 2 * 60;
hold_time    = 2 * 60;
fade_out_time= 2 * 60;
splash_color = global.splash_color;

total_time = fade_in_time + hold_time + fade_out_time;

// text
stage_no =  global.stage_number;
stage_name = global.stage_name;

// positioning
base_x = 40;
base_y = 120;
indent = 80; // big indent for stage name